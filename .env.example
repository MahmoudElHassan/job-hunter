# Job Hunter — environment variables template
# Copy to .env and fill in real values. NEVER commit .env to git.

# Tavily search API (https://tavily.com — 1000 free searches/month)
# Get yours at: https://app.tavily.com/home
TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXX

# Hunter.io email finder (https://hunter.io — 25 free searches/month)
# Get yours at: https://hunter.io/api-keys
HUNTER_API_KEY=

# Telegram bot token (from @BotFather)
# Get yours by messaging @BotFather on Telegram, /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Your Telegram chat_id (use @userinfobot or @RawDataBot to find it)
TELEGRAM_CHAT_ID=1698811695

# Optional: LLM for CV tailoring. If blank, Mavis (in-chat) will do it.
# Gemini free: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: GitHub PAT for portfolio push (if not using SSH)
# Needs 'repo' scope to push to MahmoudElHassan/My_Portofolio
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXX

# Optional: Gmail OAuth (Phase 2 — not used yet)
# Get from Google Cloud Console: enable Gmail API, create OAuth client, run local auth flow
GMAIL_CREDENTIALS_PATH=
